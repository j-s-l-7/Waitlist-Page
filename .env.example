# Copy to .env.local for local work (never commit real values).
# In production, set these in Vercel: Project -> Settings -> Environment Variables.

# Required: Supabase transaction pooler URI (Supabase -> Connect -> Transaction pooler, port 6543).
# Not the direct db.<ref>.supabase.co host (IPv6-only, unreachable from Vercel).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres

# Optional: PEM CA bundle to verify the DB server certificate. Literal "\n"
# sequences are converted to newlines. When unset, TLS is used without
# certificate verification.
DATABASE_CA_CERT=
